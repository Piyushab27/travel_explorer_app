# Copy this file to ".env" and paste your key. The ".env" file is git-ignored; never commit it
# and never put the key in app code or an EXPO_PUBLIC_* variable (those ship inside the app).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional
# GEMINI_MODEL=gemini-3.6-flash        # tried first; busy / out-of-quota models fall back automatically
# GEMINI_THINKING_BUDGET=0             # 0 = thinking off (faster, cheaper, no truncated JSON)
# RATE_LIMIT_PER_MIN=20                # AI requests allowed per IP per minute
# PORT=8787
